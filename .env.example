NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://khrufai_app:change-this@localhost:5432/khrufai_dev
# Locally use certs/ca.pem. On Vercel set PGSSLROOTCERT_BASE64 to the base64-encoded Aiven CA PEM.
PGSSLROOTCERT=certs/ca.pem
PGSSLROOTCERT_BASE64=
PGPOOL_MAX=3
PGCONNECT_TIMEOUT_MS=10000
SESSION_COOKIE_NAME=khrufai.sid
SESSION_TTL_HOURS=12
REMEMBER_TTL_DAYS=30
# Use a long, unique value in production. Never commit a real .env file.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional filesystem root for relative proof paths already stored on registrations.
LEGACY_STORAGE_PUBLIC_DIR=
